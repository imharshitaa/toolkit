# Copy this file to .env and fill in real values before running
# `docker compose up`. Everything here stays on your machine — this lab
# stack is local-only and these are not third-party SaaS credentials.
#
#   cp .env.example .env

# Splunk Enterprise
SPLUNK_PASSWORD=changeme123
SPLUNK_HEC_TOKEN=replace-with-a-random-token

# OWASP ZAP
ZAP_API_KEY=replace-with-a-random-key

# Wazuh indexer (OpenSearch) and API
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=changeme123
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=changeme123
